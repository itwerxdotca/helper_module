<?php
/**
 * @file
 * Primary module hooks for Helper Module.
 */
declare(strict_types=1);
use Drupal\Core\Form\FormStateInterface;
/**
 * Implements hook_help().
 */
function helper_module_help(string $route_name, $route_match) {
  switch ($route_name) {
    case 'help.page.helper_module':
      $output = '<h2>' . t('About') . '</h2>';
      $output .= '<p>' .  t('Helper Module provides a pluggable architecture for site-specific customizations using the Drupal plugin system.') . '</p>';
      $output .= '<h2>' . t('Creating Helper Plugins') . '</h2>';
      $output .= '<p>' . t('To create a helper plugin, create a PHP class in the <code>src/Plugin/Helper</code> directory that extends <code>HelperBase</code> and uses the <code>#[Helper]</code> attribute.') . '</p>';
      return $output;
  }
  return '';
}
/**
 * Implements hook_form_alter().
 */
function helper_module_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'node_listing_form' || $form_id === 'node_listing_edit_form') {
    $helper_manager = \Drupal::service('plugin.manager.helper');
    try {
      $location_helper = $helper_manager->createInstance('location_form');
      if (method_exists($location_helper, 'alterListingForm')) {
        $location_helper->alterListingForm($form, $form_state);
      }
      else {
        throw new \LogicException('The LocationFormHelper plugin is missing the required method alterListingForm.');
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('helper_module')->error('An error occurred while loading the LocationFormHelper plugin: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }
}
/**
 * Implements hook_ENTITY_TYPE_presave() for node entities.
 */
function helper_module_node_presave(Drupal\Core\Entity\EntityInterface $node) {
  if ($node->bundle() !== 'listing') {
    return;
  }
  $helper_manager = \Drupal::service('plugin.manager.helper');
  try {
    $location_helper = $helper_manager->createInstance('location_form');
    if (method_exists($location_helper, 'geocodeListing')) {
      $location_helper->geocodeListing($node);
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('helper_module')->error('Error geocoding listing: @message', ['@message' => $e->getMessage()]);
  }
}

/**
  * Implements hook_metatags_alter().
  */
 function helper_module_metatags_alter(array &$metatags, array $context) {
   if (!isset($context['entity'])) {
     return;
   }

   $entity = $context['entity'];

   if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'listing') {
     return;
   }

   if (!$entity->hasField('field_listing_category') || $entity->get('field_listing_category')->isEmpty()) {
     return;
   }

   $helper_manager = \Drupal::service('plugin.manager.helper');
   try {
     $schema_helper = $helper_manager->createInstance('schema_type_mapper');
     $term_id = (int) $entity->get('field_listing_category')->target_id;
     $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($term_id);

     if ($term && method_exists($schema_helper, 'getSchemaTypeForTerm')) {
       $schema_type = $schema_helper->getSchemaTypeForTerm($term);

       // Update the schema_place_type metatag
       if ($schema_type !== NULL && isset($metatags['schema_place_type'])) {
         file_put_contents('/tmp/metatag_alter_debug.txt',
           date('Y-m-d H:i:s') . " - Changing schema_place_type from " .
           $metatags['schema_place_type'] . " to " . $schema_type .
           " for node " . $entity->id() . "\n", FILE_APPEND);

         $metatags['schema_place_type'] = $schema_type;
       }
     }
   }
   catch (\Exception $e) {
     file_put_contents('/tmp/metatag_alter_debug.txt',
       "Error: " . $e->getMessage() . "\n", FILE_APPEND);
   }
 }
